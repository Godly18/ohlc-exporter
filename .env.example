# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit real values.
# On Render, set these in the dashboard (Environment tab) instead.
# ---------------------------------------------------------------------------

# --- OANDA (backend only) ---------------------------------------------------
OANDA_API_TOKEN=
# "practice" (api-fxpractice.oanda.com) or "live" (api-fxtrade.oanda.com)
OANDA_ENVIRONMENT=practice

# --- Twelve Data (used ONLY for XAUUSD / gold) -------------------------------
# Leave empty to hide XAU/USD. Free plan: 8 requests/minute, 800 credits/day (the app paces itself).
TWELVEDATA_API_KEY=
TWELVEDATA_RATE_PER_MIN=8
# Days fetched per request (1-3). 3 days of 1-minute gold candles stay under the 5000-row response limit.
TWELVEDATA_WINDOW_DAYS=3
TWELVEDATA_TIMEOUT_MS=60000
TWELVEDATA_MAX_RETRIES=3

# --- Binance Spot (23 crypto pairs; public endpoints, NO key needed) ----------
# Monthly archive is used first for months that have fully ended; the REST API is used otherwise.
BINANCE_API_BASE=https://data-api.binance.vision
BINANCE_ARCHIVE_BASE=https://data.binance.vision
BINANCE_ARCHIVE_ENABLED=true
BINANCE_REQUEST_DELAY_MS=150
BINANCE_TIMEOUT_MS=60000
BINANCE_MAX_RETRIES=3

# --- Downloads built and served by GitHub Actions (saves this server's bandwidth) ---
# "github": the CSV is zipped by .github/workflows/export-csv.yml and the download link redirects to GitHub.
# "server": the server zips into R2 and streams the file itself (local development).
# Left empty = github when GH_EXPORT_TOKEN and GH_REPO are set, otherwise server.
EXPORT_MODE=
# Fine-grained token for THIS repository only, permission "Actions: Read and write" (nothing else).
GH_EXPORT_TOKEN=
# owner/name of the repository that contains .github/workflows/export-csv.yml
GH_REPO=
GH_WORKFLOW_FILE=export-csv.yml
# Branch that holds the workflow file
GH_REF=main
# Give up (and cancel the run) if GitHub has not finished building the file after this long
GH_RUN_TIMEOUT_SECONDS=3000
GH_START_TIMEOUT_SECONDS=120
# The workflow itself reads these from the REPOSITORY's Actions secrets (not from this file):
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY (read & write token), R2_BUCKET_NAME,
#   DATABASE_URL (+ DATABASE_SSL), OANDA_API_TOKEN, TWELVEDATA_API_KEY - the workflow retrieves the data itself

# --- Cloudflare R2 (S3-compatible, backend only) ----------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Database ---------------------------------------------------------------
# Render Postgres: use the INTERNAL connection string for a service in the same region.
# Local dev without Postgres: sqlite:./data/dev.db  (NOT for production: Render's disk is ephemeral)
DATABASE_URL=
# Set to true when connecting to Postgres over the public (external) URL.
DATABASE_SSL=false

# --- Security ---------------------------------------------------------------
# Long random string. Used to derive download tokens. Render can generate it (see render.yaml).
EXPORT_TOKEN_SECRET=

# --- Server -----------------------------------------------------------------
PORT=10000
NODE_ENV=production

# --- Exports ----------------------------------------------------------------
EXPORT_EXPIRATION_MINUTES=5
CLEANUP_INTERVAL_SECONDS=60
# Safety cap so a single export cannot exhaust the 512 MB free-tier memory.
MAX_EXPORT_YEARS=2

# --- Global lock ------------------------------------------------------------
LOCK_LEASE_SECONDS=90
LOCK_HEARTBEAT_SECONDS=15

# --- Data rules -------------------------------------------------------------
# A just-ended UTC day is only fetched this many minutes after midnight UTC.
DAY_SETTLE_MINUTES=10
# Forex first year. Crypto is always >= 2018 and XAUUSD >= 2021 (fixed per instrument in backend/config/catalog.js).
MIN_DATA_YEAR=2010
# Save the days retrieved so far every N downloaded days during long builds (a restart resumes from there).
CHECKPOINT_DAYS=30
# Optional: extra comma-separated YYYY-MM-DD dates that are EXPECTED to be empty (market closed). Empty days are accepted
# either way; these dates are just not listed as missing in the missing-data report (forex/gold only).
EXTRA_CLOSED_DATES=

# --- OANDA request behaviour ------------------------------------------------
OANDA_TIMEOUT_MS=30000
OANDA_MAX_RETRIES=3
OANDA_REQUEST_DELAY_MS=250

# --- Background maintenance of current-year datasets ------------------------
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_MINUTES=60
MAINTENANCE_START_DELAY_SECONDS=120

# --- Render keep-alive self ping (free tier spins down after 15 min idle) ---
# Render sets RENDER_EXTERNAL_URL automatically; the ping is enabled when it exists.
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_MINUTES=10

# --- Rate limiting (per client IP, per minute) ------------------------------
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_EXPORT_PER_MIN=20
# How many proxy hops to trust when reading X-Forwarded-For (Render = 1)
TRUST_PROXY_HOPS=1
